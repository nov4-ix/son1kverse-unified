# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
ALLOW_ANON_DEV=false
ADMIN_UNLIMITED=true

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://son1kverse:son1kverse@localhost:5432/son1kverse?schema=public"

# ─── Auth (JWT — custom, no Supabase) ────────────────────────────────────────
# IMPORTANTE: Generar con: openssl rand -base64 64
# El servidor se niega a arrancar con este placeholder.
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=7d

# ─── Music Lab (único motor de audio, FastAPI) ───────────────────────────────
MUSIC_LAB_URL=http://127.0.0.1:8002
# Opcional: si el servicio arranca con MUSIC_LAB_API_KEY, el backend la envía.
MUSIC_LAB_API_KEY=
# Timeout por request y reintentos con backoff para lecturas idempotentes
# (health, estado de job y descarga de audio). Los POST no se reintentan.
MUSIC_LAB_TIMEOUT_MS=15000
MUSIC_LAB_RETRIES=2
MUSIC_LAB_RETRY_BACKOFF_MS=500

# ─── Cloudflare R2 (opcional, S3-compatible) ─────────────────────────────────
# Si falta cualquier credencial, el audio se queda en Music Lab y se avisa en
# logs. La API key y el secreto NUNCA van al repo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_KEY_PREFIX=generations
R2_SIGNED_URL_TTL_SECONDS=3600

# ─── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Pixel — Orquestador ──────────────────────────────────────────────────────
PIXEL_DEFAULT_MODEL=anthropic/claude-3-haiku
PIXEL_ANALYSIS_MODEL=anthropic/claude-3-haiku

# ─── Memory ───────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-ada-002
MAX_MEMORY_CONTEXT=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
SYSTEM_VERSION=0.1.0
