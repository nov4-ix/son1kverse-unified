{
  "name": "@son1k/api",
  "version": "0.1.0",
  "description": "Creative Operating System — AI-powered artistic identity orchestration",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @son1k/db build && pnpm --filter @son1k/shared-types build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/server.js",
    "pretest": "pnpm --filter @son1k/db build && pnpm --filter @son1k/shared-types build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:audio": "node scripts/e2e-audio.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@son1k/db": "workspace:*",
    "@son1k/shared-types": "workspace:^",
    "fastify": "^4.26.2",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
