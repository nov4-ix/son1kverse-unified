# ─── Service ─────────────────────────────────────────────────────────────────
SERVICE_NAME=son1kverse-music-lab
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=8002

# simulation | ace-step
MUSIC_LAB_MODE=simulation
# Empty means no auth (intended for local simulation only).
MUSIC_LAB_API_KEY=
MUSIC_LAB_OUTPUT_DIR=./outputs
MUSIC_LAB_MAX_CONCURRENCY=1
MUSIC_LAB_JOB_TTL_HOURS=24
MUSIC_LAB_MAX_JOBS=500
MUSIC_LAB_JOB_CLEANUP_INTERVAL_S=60
MUSIC_LAB_SAMPLE_RATE=44100

# Simulated latency per job in milliseconds (tests use 0).
SIM_LATENCY_MS=0

# ─── ACE-Step 1.5 (GPU only, lazy) ──────────────────────────────────────────
# Checkpoints live directly under this directory (acestep-v15-turbo/, vae/, ...).
# With ACE_STEP_AUTO_DOWNLOAD=true they are fetched from
# https://huggingface.co/ACE-Step/Ace-Step1.5 on first generation (~8 GB).
ACE_STEP_MODEL_PATH=/models/ace-step
ACE_STEP_DEVICE=cuda
# T4: bfloat16 forzado (medido 7/7 OK). float16 produce NaN en T4.
ACE_STEP_DTYPE=bfloat16
# Optional torchao quantization (int8_weight_only, fp8_weight_only,
# w8a8_dynamic). Empty disables it. torchao is NOT installed by default.
ACE_STEP_QUANTIZATION=
# true recomienda CPU offload en T4 (16 GB).
ACE_STEP_OFFLOAD=false
ACE_STEP_PYTHON_MODULE=acestep
ACE_STEP_CONFIG_PATH=acestep-v15-turbo
ACE_STEP_AUTO_DOWNLOAD=true
# huggingface | modelscope | empty for automatic selection
ACE_STEP_DOWNLOAD_SOURCE=
# DiT-only by default. true loads the 5Hz LM planner (extra VRAM/weights).
ACE_STEP_USE_LM=false
ACE_STEP_LM_MODEL=acestep-5Hz-lm-1.7B
# pt works without nano-vllm; vllm requires acestep/third_parts/nano-vllm.
ACE_STEP_LM_BACKEND=pt
ACE_STEP_INFERENCE_STEPS=8
ACE_STEP_GUIDANCE_SCALE=7.0
ACE_STEP_SHIFT=3.0
ACE_STEP_VOCAL_LANGUAGE=unknown

# El único motor GPU es ACE-Step.

# Archivado en Cloudflare R2 (opcional). Sin las 4 primeras, el audio solo queda en disco.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_KEY_PREFIX=generations
