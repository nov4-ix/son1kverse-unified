# GPU image. Model weights are NEVER baked in: mount them at /models.
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUSIC_LAB_MODE=ace-step \
    MUSIC_LAB_OUTPUT_DIR=/outputs \
    MUSIC_LAB_MAX_CONCURRENCY=1 \
    ACE_STEP_MODEL_PATH=/models/ace-step \
    ACE_STEP_DEVICE=cuda \
    ACE_STEP_DTYPE=bfloat16 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        curl \
        git \
        libsndfile1 \
        ffmpeg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3.11-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel

COPY requirements.txt requirements-gpu.txt requirements-ace-step.txt ./
RUN pip install --no-cache-dir -r requirements-gpu.txt \
    && pip install --no-cache-dir --no-deps --ignore-requires-python -r requirements-ace-step.txt

COPY app ./app
COPY scripts ./scripts

RUN groupadd --gid 10001 musiclab \
    && useradd --uid 10001 --gid musiclab --create-home musiclab \
    && mkdir -p /outputs /models \
    && chown -R musiclab:musiclab /app /outputs /models

USER musiclab

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health', timeout=3).read()"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
